# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Shared password required to open the Hub 3AC website
HUB_SITE_PASSWORD=choose_a_long_unique_password

# Random secret used to sign secure login cookies (minimum 32 characters)
# Generate with: openssl rand -base64 48
HUB_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
